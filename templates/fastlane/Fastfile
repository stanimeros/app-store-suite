# Generated by `appstoresuite init`. Everything here works as-is except the
# four constants below — fill those in with your own credentials and this
# file needs no further changes. Lane names match appstoresuite's defaults
# (ship-ios -> ship_testflight, ship-android -> ship_internal), so
# `appstoresuite ship-ios` / `ship-android` work once the constants are set.

default_platform(:android)

ANDROID_PACKAGE_NAME = "__ANDROID_PACKAGE__"
IOS_BUNDLE_ID = "__BUNDLE_ID__"

REPO_ROOT = File.expand_path("..", __dir__)

# Play Console service account JSON (Setup > API access in Play Console).
PLAY_JSON_KEY = File.join(REPO_ROOT, "keys", "your-service-account.json")

# App Store Connect API key (Users and Access > Integrations in App Store Connect).
ASC_KEY_ID = "TODO_ASC_KEY_ID"
ASC_ISSUER_ID = "TODO_ASC_ISSUER_ID"
ASC_KEY_PATH = File.join(REPO_ROOT, "keys", "AuthKey_TODO_ASC_KEY_ID.p8")

def pubspec_version
  content = File.read(File.join(REPO_ROOT, "pubspec.yaml"))
  match = content.match(/^version:\s*['"]?(\d+\.\d+\.\d+)\+(\d+)['"]?/)
  UI.user_error!("Could not parse version from pubspec.yaml") unless match
  { name: match[1], code: match[2].to_i }
end

platform :android do
  desc "Check pubspec build number against the highest live Play Store version code, build the AAB, then upload it to internal testing"
  lane :ship_internal do
    v = pubspec_version
    UI.message("Local pubspec version: #{v[:name]}+#{v[:code]}")

    live_codes = google_play_track_version_codes(
      package_name: ANDROID_PACKAGE_NAME,
      json_key: PLAY_JSON_KEY,
      track: "internal"
    )
    prod_codes = google_play_track_version_codes(
      package_name: ANDROID_PACKAGE_NAME,
      json_key: PLAY_JSON_KEY,
      track: "production"
    )
    highest_live = (live_codes + prod_codes + [0]).max
    UI.message("Highest live Play Store version code: #{highest_live}")

    if v[:code] <= highest_live
      UI.user_error!("pubspec.yaml build number (#{v[:code]}) must be greater than the highest live Play Store version code (#{highest_live}). Bump the +build number in pubspec.yaml and rebuild.")
    end

    UI.message("Building Android App Bundle")
    sh("bash -lc 'cd #{REPO_ROOT} && flutter build appbundle'")

    aab_glob = File.join(REPO_ROOT, "build", "app", "outputs", "bundle", "**", "*.aab")
    candidates = Dir.glob(aab_glob)
    UI.user_error!("No .aab found under build/app/outputs/bundle - `flutter build appbundle` did not produce one.") if candidates.empty?
    aab_path = candidates.max_by { |f| File.mtime(f) }
    UI.message("Uploading AAB: #{aab_path}")

    supply(
      json_key: PLAY_JSON_KEY,
      package_name: ANDROID_PACKAGE_NAME,
      aab: aab_path,
      track: "internal",
      release_status: "completed",
      skip_upload_changelogs: true,
      skip_upload_metadata: true,
      changes_not_sent_for_review: true
    )
    UI.success("Uploaded #{v[:name]}+#{v[:code]} to Play Store internal testing")
  end
end

platform :ios do
  desc "Check pubspec build number against the highest live App Store Connect build number, build the ipa, then upload it to TestFlight"
  lane :ship_testflight do
    v = pubspec_version
    UI.message("Local pubspec version: #{v[:name]}+#{v[:code]}")

    api_key = app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_PATH,
      in_house: false
    )

    latest_testflight = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: IOS_BUNDLE_ID
    ).to_i

    latest_live = begin
      app_store_build_number(
        api_key: api_key,
        app_identifier: IOS_BUNDLE_ID,
        live: true
      ).to_i
    rescue StandardError
      0
    end

    highest_live = [latest_testflight, latest_live].max
    UI.message("Highest live App Store Connect build number: #{highest_live}")

    if v[:code] <= highest_live
      UI.user_error!("pubspec.yaml build number (#{v[:code]}) must be greater than the highest live App Store Connect build number (#{highest_live}). Bump the +build number in pubspec.yaml and rebuild.")
    end

    UI.message("Building iOS ipa")
    sh("bash -lc 'cd #{REPO_ROOT} && flutter build ipa'")

    ipa_glob = File.join(REPO_ROOT, "build", "ios", "ipa", "*.ipa")
    candidates = Dir.glob(ipa_glob)
    UI.user_error!("No .ipa found under build/ios/ipa - `flutter build ipa` did not produce one.") if candidates.empty?
    ipa_path = candidates.max_by { |f| File.mtime(f) }
    UI.message("Uploading ipa: #{ipa_path}")

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      app_identifier: IOS_BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
    UI.success("Uploaded #{v[:name]}+#{v[:code]} to App Store Connect / TestFlight")
  end
end
